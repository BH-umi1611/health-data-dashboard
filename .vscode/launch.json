{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run Web Dashboard (Flask)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/app.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Run Health Data Analysis (scripts)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Run scripts with fresh sample data",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "args": ["--regenerate"],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        }
    ]
}
